# Copy this file to .env and fill it in. Never commit .env.

# PostgreSQL connection
DATABASE_URL=postgres://danchi:CHANGE_ME@localhost:5432/danchi

# Better Auth
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Local: http://localhost:3000   Production: https://danchi.rafiarsya.com
# (on the mini PC, deploy/setup-minipc.sh writes all of this for you)
BETTER_AUTH_URL=http://localhost:3000

# The only two accounts (owner can edit, viewer can only look)
DANCHI_OWNER_EMAIL=vyraruka@gmail.com
DANCHI_OWNER_NAME=Sayang
DANCHI_VIEWER_EMAIL=rafiarsya.work@gmail.com
DANCHI_VIEWER_NAME=Rafi

# ---------- Google sign in (the only way in) ----------
# console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Redirect URI: https://danchi.rafiarsya.com/api/auth/callback/google  (and http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google accounts can get in (comma separated). Defaults to the two emails above.
ALLOWED_EMAILS=vyraruka@gmail.com,rafiarsya.work@gmail.com
# Emergency only: also allow the backup passwords from `npm run seed`
ALLOW_PASSWORD_LOGIN=false

# Dates and "today" follow this timezone
APP_TIMEZONE=Asia/Kuala_Lumpur

# Port used by `npm start` on the mini PC
PORT=3100

# Public address (used in emails and push links)
APP_URL=https://danchi.rafiarsya.com

# ---------- Push notifications (phone pings) ----------
# Generate once with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Email ----------
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# App password without spaces
SMTP_PASS=your16letterapppassword
MAIL_FROM="Chichi from Danchi <you@gmail.com>"
# Optional: send to a different address than the owner's login email
MAIL_TO=

# ---------- Ask Chichi (Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
# Claude (smartest). If set, Chichi uses Claude first and Gemini as backup.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# optional: low | medium | high (how hard Claude thinks; empty = model default)
ANTHROPIC_EFFORT=
# optional: AI_PROVIDER=gemini forces Gemini first
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used automatically if the main model isn't available for your key
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Questions per person per day
AI_DAILY_LIMIT=40

# Private uploads (papers, notes, project files). Default: ./data/uploads
UPLOAD_DIR=

# SOS: real phone calls + SMS when she presses SOS 3 times (Twilio)
SOS_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Spotify Web API (Our music: song lists + search). Redirect URI: <APP_URL>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
